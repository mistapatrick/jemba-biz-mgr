# Public Supabase project settings. These values are intentionally browser-visible.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Server-only secrets. Never use NEXT_PUBLIC_ for these values.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
JEMBA_BOOTSTRAP_SECRET=GENERATE_A_LONG_RANDOM_ONE_TIME_SECRET
